# ============================================================
#  Ophélia Microservice — Configuration
# ============================================================

# Tesseract OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=fra

# Modèle LayoutLMv3 (ONNX)
MODEL_PATH=./models_cache/layoutlmv3
MODEL_DEVICE=cpu

# Seuils du modèle (cf. Chapitre 4, Tableau 4.1)
MATCHING_THRESHOLD=0.7
WEIGHT_TYPE=0.25
WEIGHT_KEYS=0.25
WEIGHT_SPATIAL=0.25
WEIGHT_OCR=0.25
SPATIAL_TOLERANCE=10.0
ADAPTATION_STEP=0.1

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Serveur
API_HOST=0.0.0.0
API_PORT=8000

# Dolibarr — chemin racine des documents
DOLIBARR_DOCUMENTS_PATH=C:\wamp64\www\dolibarr\documents
